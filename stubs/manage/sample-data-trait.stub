<?php

namespace App\Traits\__Model__;

use App\Models\__Model__;
use Illuminate\Support\Collection;

/**
 * Dev-only sample-data generator for the __pluralLabel__ list page.
 * Per .ai/rules/dev-autofill.md.
 */
trait GeneratesSampleData
{
    /**
     * Create sample __pluralLabel__ backed by real database records.
     *
     * @return Collection<int, __Model__>
     */
    protected function generateSample__Plural__(int $count = 10): Collection
    {
        return __Model__::factory()->count($count)->create();
    }
}
