<?php

namespace App\Http\Controllers\Api;

use App\Http\Controllers\Controller;
use App\Http\Requests\__Model__\BulkDelete__Model__Request;
use App\Http\Requests\__Model__\Store__Model__Request;
use App\Http\Requests\__Model__\Update__Model__Request;
use App\Http\Resources\__Model__Resource;
use App\Models\__Model__;
use App\Services\__Model__ManagementService;
use App\Traits\__Model__\DocumentsApi;
use App\Traits\__Model__\GeneratesSampleData;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;
use Illuminate\Http\Resources\Json\AnonymousResourceCollection;
use Illuminate\Http\Response;

class __Model__Controller extends Controller
{
    use DocumentsApi, GeneratesSampleData;

    public function __construct(
        protected __Model__ManagementService $__modelVar__ManagementService,
    ) {}

    public function index(Request $request): AnonymousResourceCollection
    {
        $search = $request->string('search')->value() ?: null;

        return __Model__Resource::collection($this->__modelVar__ManagementService->paginate(
            perPage: min(max($request->integer('per_page', 10), 1), 100),
            search: $search,
            sort: $request->string('sort')->value() ?: null,
            direction: $request->string('direction', 'asc')->value(),
        ))->additional([
            'deletable_total' => $this->__modelVar__ManagementService->countMatching($search),
        ]);
    }

    public function bulkDestroy(BulkDelete__Model__Request $request): Response
    {
        if ($request->boolean('all')) {
            $this->__modelVar__ManagementService->deleteMatching($request->validated('search'));
        } else {
            $this->__modelVar__ManagementService->deleteMany($request->validated('ids'));
        }

        return response()->noContent();
    }

    public function generate(Request $request): AnonymousResourceCollection
    {
        $validated = $request->validate([
            'count' => ['required', 'integer', 'min:1', 'max:50'],
        ]);

        return __Model__Resource::collection($this->generateSample__Plural__($validated['count']));
    }

    public function show(__Model__ $__modelVar__): __Model__Resource
    {
        return new __Model__Resource($__modelVar__);
    }

    public function store(Store__Model__Request $request): JsonResponse
    {
        $__modelVar__ = $this->__modelVar__ManagementService->create($request->validated());

        return (new __Model__Resource($__modelVar__))->response()->setStatusCode(201);
    }

    public function update(Update__Model__Request $request, __Model__ $__modelVar__): __Model__Resource
    {
        return new __Model__Resource($this->__modelVar__ManagementService->update($__modelVar__, $request->validated()));
    }

    public function destroy(__Model__ $__modelVar__): Response
    {
        $this->__modelVar__ManagementService->delete($__modelVar__);

        return response()->noContent();
    }
}
