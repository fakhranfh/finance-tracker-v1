<?php

namespace App\Http\Controllers;

use Illuminate\View\View;

class __Model__PageController extends Controller
{
    public function index(): View
    {
        $tableHeaders = [
__tableHeaders__
            __('__slug__.table.actions'),
        ];

        return view('__slug__.index', ['tableHeaders' => $tableHeaders]);
    }

    public function create(): View
    {
        return view('__slug__.form', ['id' => null]);
    }

    public function edit(int $id): View
    {
        return view('__slug__.form', ['id' => $id]);
    }
}
