                                    },
                                    "balance": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 9.99
                                    },
                                    "color": {
                                        "description": "One of the colors in config/account.php",
                                        "type": "string",
                                        "example": "#2563EB"
                                    },
                                    "icon": {
                                        "type": "string",
                                        "example": "wallet",
                                        "enum": [
                                            "cash",
